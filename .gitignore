
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Frontend
frontend/node_modules
frontend/dist
frontend/.svelte-kit
frontend/.vite

# Defensive: catch node_modules / .vite folders that occasionally end
# up outside frontend/ when pnpm is run from the repo root by mistake.
/node_modules/
**/.vite/

# Tauri
crates/ivac-tauri/target

# Tauri mobile: track the gen/android SOURCE tree so the Android build is
# reproducible without re-running `cargo tauri android init` (a re-init
# would also clobber the MainActivity onBackPressed/onActivityCreate fix).
# The Tauri-generated gen/android/.gitignore + app/.gitignore (both tracked
# as source) already exclude the build outputs; the lines below keep the
# non-android generated dir out and are a belt-and-suspenders net for the
# machine-specific / large-binary artifacts that must never be committed.
crates/ivac-tauri/gen/schemas/
crates/ivac-tauri/gen/android/.gradle/
crates/ivac-tauri/gen/android/build/
crates/ivac-tauri/gen/android/app/build/
crates/ivac-tauri/gen/android/.tauri/
crates/ivac-tauri/gen/android/tauri.settings.gradle
crates/ivac-tauri/gen/android/local.properties
crates/ivac-tauri/gen/android/app/tauri.properties
crates/ivac-tauri/gen/android/app/src/main/jniLibs/**/*.so
crates/ivac-tauri/gen/android/**/.kotlin/

# WASM
crates/ivac-wasm/pkg

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Local env
.env
.env.local

# Upstream clones — checked out alongside but not tracked here.
# Bring your own copies via:
#   git clone https://github.com/multigcs/viaconstructor refs/viaconstructor
#   git clone https://github.com/IxMilia/dxf-rs        refs/dxf-rs
refs/
!refs/.gitkeep

# Local Claude-Code session state.
.claude/

# Local Python venv used by tests/golden/refresh.py.
.venv-golden/
**/__pycache__/

# Tempfiles + samples generated during demos.
frontend/public/samples/*-rust.json
frontend/public/samples/*-generated.json

# Staged build artifacts handed to testers (APK / AppImage). Not tracked.
dist-test/
